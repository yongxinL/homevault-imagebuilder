#!/usr/bin/env bash
# =============================================================================
#
# - Copyright (C) 2016     George Li <yongxinl@outlook.com>
#
# - This is part of HomeVault imagebuilder project.
# - cleanup_rootfs_kernel.sh — Kernel module pruning for the live image
#
# Purpose:
#   Remove kernel modules that are not needed in a headless server/NAS
#   environment running inside VMware ESXi.  Removing unused modules
#   significantly reduces the initrd and squashfs image sizes.
#
#   Modules removed:
#     - GPU / video drivers  (no display hardware in ESXi VMs)
#     - Sound / multimedia   (no audio hardware in ESXi VMs)
#     - Wireless / Bluetooth (server NIC only)
#     - Exotic network protocols (AppleTalk, CAN, BATMAN, etc.)
#     - Obscure filesystems  (9p, adfs, affs, etc.)
#     - Unused SCSI adapters (Brocade, Emulex, QLogic FC HBAs)
#     - Miscellaneous hardware (parport, PCMCIA, NFC, etc.)
#
# Kept modules:
#   virtio, vmxnet3, vmw_pvscsi, overlay, squashfs, ext4, btrfs, xfs,
#   ntfs3, fat, vfat, mdadm (raid), lvm2, network fundamentals
#
# IMPORTANT: This script uses the kernel version from the Ansible variable
#   {{ build_kernel_version }} — set in group_vars/in_target.yml.
#   The path /lib/modules/{{ build_kernel_version }}/ must exist.
#
# =============================================================================

set -e

KVER="{{ build_kernel_version }}"
KMOD_PATH="/lib/modules/${KVER}/kernel"

echo "=== Kernel module cleanup for ${KVER} ==="

if [ ! -d "${KMOD_PATH}" ]; then
    echo "  WARNING: kernel module path ${KMOD_PATH} not found — skipping module cleanup"
    exit 0
fi

# ------------------------------------
#   GPU / Video drivers
# ------------------------------------
echo ""
echo "[1/5] Removing GPU and video drivers ..."

rm -rf "${KMOD_PATH}/drivers/gpu/drm/nouveau"    # nVidia (not present in ESXi VMs)
rm -rf "${KMOD_PATH}/drivers/gpu/drm/radeon"     # AMD Radeon (not present in ESXi VMs)
rm -rf "${KMOD_PATH}/drivers/gpu/drm/amd"        # AMDGPU
rm -rf "${KMOD_PATH}/drivers/gpu/drm/ast"        # ASPEED server BMC (not needed headless)
rm -rf "${KMOD_PATH}/drivers/gpu/drm/gma500"     # Intel GMA500 (not in ESXi VMs)
rm -rf "${KMOD_PATH}/drivers/gpu/drm/i2c"
rm -rf "${KMOD_PATH}/drivers/gpu/drm/i810"
rm -rf "${KMOD_PATH}/drivers/gpu/drm/i915"       # Intel HD Graphics
rm -rf "${KMOD_PATH}/drivers/gpu/drm/mga"
rm -rf "${KMOD_PATH}/drivers/gpu/drm/qxl"        # QEMU QXL (not used in ESXi)
rm -rf "${KMOD_PATH}/drivers/gpu/drm/savage"
rm -rf "${KMOD_PATH}/drivers/gpu/drm/sis"
rm -rf "${KMOD_PATH}/drivers/gpu/drm/tdfx"
rm -rf "${KMOD_PATH}/drivers/gpu/drm/vgem"
rm -rf "${KMOD_PATH}/drivers/gpu/drm/via"

echo "  done."

# ------------------------------------
#   Multimedia / Sound drivers
# ------------------------------------
echo ""
echo "[2/5] Removing sound and multimedia drivers ..."

rm -rf "${KMOD_PATH}/sound"
rm -rf "${KMOD_PATH}/drivers/media"
rm -rf "${KMOD_PATH}/drivers/staging/media"
rm -rf "${KMOD_PATH}/drivers/staging/speakup"

echo "  done."

# ------------------------------------
#   Filesystem modules (uncommon/exotic)
# ------------------------------------
echo ""
echo "[3/5] Removing unused filesystem and SCSI drivers ..."

rm -rf "${KMOD_PATH}/fs/9p"     # Plan 9 (not needed)
rm -rf "${KMOD_PATH}/fs/adfs"   # Acorn ADFS
rm -rf "${KMOD_PATH}/fs/affs"   # Amiga FFS
rm -rf "${KMOD_PATH}/fs/afs"    # AFS network filesystem
rm -rf "${KMOD_PATH}/fs/bfs"    # SCO BFS
rm -rf "${KMOD_PATH}/fs/coda"   # Coda distributed filesystem
rm -rf "${KMOD_PATH}/fs/ocfs2"  # Oracle Cluster FS

# SCSI HBA drivers not present in ESXi VMs
rm -rf "${KMOD_PATH}/drivers/scsi/bfa"     # Brocade HBA
rm -rf "${KMOD_PATH}/drivers/scsi/lpfc"    # Emulex HBA
rm -rf "${KMOD_PATH}/drivers/scsi/qla2xxx" # QLogic Fibre Channel
rm -rf "${KMOD_PATH}/drivers/scsi/aic7xxx" # Adaptec AIC-7xxx
rm -rf "${KMOD_PATH}/drivers/scsi/qla4xxx" # QLogic iSCSI

echo "  done."

# ------------------------------------
#   Network drivers and protocols (unused in ESXi server environment)
# ------------------------------------
echo ""
echo "[4/5] Removing unused network drivers and protocols ..."

rm -rf "${KMOD_PATH}/drivers/bluetooth"
rm -rf "${KMOD_PATH}/drivers/firewire"
rm -rf "${KMOD_PATH}/drivers/net/appletalk"
rm -rf "${KMOD_PATH}/drivers/net/arcnet"
rm -rf "${KMOD_PATH}/drivers/net/caif"
rm -rf "${KMOD_PATH}/drivers/net/can"
rm -rf "${KMOD_PATH}/drivers/net/ethernet/mellanox"
rm -rf "${KMOD_PATH}/drivers/net/ethernet/qlogic"
rm -rf "${KMOD_PATH}/drivers/net/fddi"
rm -rf "${KMOD_PATH}/drivers/net/hamradio"
rm -rf "${KMOD_PATH}/drivers/net/ieee802154"
rm -rf "${KMOD_PATH}/drivers/net/irda"
rm -rf "${KMOD_PATH}/drivers/net/plip"
rm -rf "${KMOD_PATH}/drivers/net/usb"     # USB NICs not used in ESXi VMs
rm -rf "${KMOD_PATH}/drivers/net/wan"
rm -rf "${KMOD_PATH}/drivers/net/wimax"
rm -rf "${KMOD_PATH}/drivers/net/wireless"
rm -rf "${KMOD_PATH}/drivers/isdn"
rm -rf "${KMOD_PATH}/net/6lowpan"
rm -rf "${KMOD_PATH}/net/appletalk"
rm -rf "${KMOD_PATH}/net/atm"
rm -rf "${KMOD_PATH}/net/ax25"
rm -rf "${KMOD_PATH}/net/batman-adv"
rm -rf "${KMOD_PATH}/net/bluetooth"
rm -rf "${KMOD_PATH}/net/caif"
rm -rf "${KMOD_PATH}/net/can"
rm -rf "${KMOD_PATH}/net/ceph"
rm -rf "${KMOD_PATH}/net/irda"
rm -rf "${KMOD_PATH}/net/mac80211"
rm -rf "${KMOD_PATH}/net/wireless"

echo "  done."

# ------------------------------------
#   Miscellaneous hardware (not present in ESXi VMs)
# ------------------------------------
echo ""
echo "[5/5] Removing miscellaneous unused hardware drivers ..."

rm -rf "${KMOD_PATH}/drivers/atm"
rm -rf "${KMOD_PATH}/drivers/auxdisplay"
rm -rf "${KMOD_PATH}/drivers/bcma"
rm -rf "${KMOD_PATH}/drivers/dca"
rm -rf "${KMOD_PATH}/drivers/dma"
rm -rf "${KMOD_PATH}/drivers/extcon"
rm -rf "${KMOD_PATH}/drivers/hsi"
rm -rf "${KMOD_PATH}/drivers/ipack"
rm -rf "${KMOD_PATH}/drivers/leds"
rm -rf "${KMOD_PATH}/drivers/macintosh"
rm -rf "${KMOD_PATH}/drivers/mailbox"
rm -rf "${KMOD_PATH}/drivers/mcb"
rm -rf "${KMOD_PATH}/drivers/memstick"
rm -rf "${KMOD_PATH}/drivers/mfd"
rm -rf "${KMOD_PATH}/drivers/nfc"
rm -rf "${KMOD_PATH}/drivers/ntb"
rm -rf "${KMOD_PATH}/drivers/nvdimm"
rm -rf "${KMOD_PATH}/drivers/parport"
rm -rf "${KMOD_PATH}/drivers/pcmcia"
rm -rf "${KMOD_PATH}/drivers/pinctrl"
rm -rf "${KMOD_PATH}/drivers/rapidio"
rm -rf "${KMOD_PATH}/drivers/regulator"
rm -rf "${KMOD_PATH}/drivers/remoteproc"
rm -rf "${KMOD_PATH}/drivers/rtc"
rm -rf "${KMOD_PATH}/drivers/spi"
rm -rf "${KMOD_PATH}/drivers/spmi"
rm -rf "${KMOD_PATH}/drivers/ssb"
rm -rf "${KMOD_PATH}/drivers/thunderbolt"
rm -rf "${KMOD_PATH}/drivers/vme"
rm -rf "${KMOD_PATH}/drivers/w1"
rm -rf "${KMOD_PATH}/drivers/staging/comedi"
rm -rf "${KMOD_PATH}/drivers/staging/lustre" 2>/dev/null || true

echo "  done."

# ------------------------------------
#   Rebuild module dependency database
# ------------------------------------
echo ""
echo "Rebuilding kernel module dependency database (depmod) ..."

for kver in $(ls /lib/modules/); do
    depmod "${kver}"
done

echo "  done."
echo ""
echo "=== Kernel module cleanup complete ==="
