#!/bin/bash
# =============================================================================
#
# - Copyright (C) 2026     George Li <yongxinl@outlook.com>
#
# - This is part of HomeVault imagebuilder project.
# - install.sh — Automated disk installer for HomeVault Live ISO
#
# WARNING: This script wipes the target disk completely.
#          Review and customise before running on a production machine.
#
# The script detects whether the machine booted via EFI or BIOS firmware and
# creates the appropriate partition layout:
#
#   EFI mode  (GPT):
#     Part 1 — 1 MB    — BIOS boot      (bios_grub flag, syslinux gptmbr fallback)
#     Part 2 — 2048 MB — EFI System     (FAT32, esp flag, labelled with hostname)
#     Part 3 — rest    — Data           (ext4, labelled 'dat01')
#   Boot paths:
#     EFI  firmware → ESP:/EFI/boot/bootx64.efi → grub.cfg → casper/vmlinuz
#     BIOS firmware → disk MBR (gptmbr.bin) → syslinux on ESP → casper/vmlinuz  [fallback]
#
#   BIOS mode (MBR):
#     Part 1 — 2048 MB — Boot partition (FAT32, boot flag, labelled with hostname)
#     Part 2 — rest    — Data           (ext4, labelled 'dat01')
#   Boot path:
#     BIOS firmware → disk MBR (mbr.bin) → syslinux on boot part → casper/vmlinuz
#
# The boot partition is always labelled with the hostname because grub.cfg uses
#   search --set=root --label <hostname>
# to locate its root.  A mismatched label causes GRUB to drop to a rescue shell.
#
# Usage (booted from the live ISO):
#   bash /cdrom/syslinux/install.sh
#
# To set a different hostname:
#   newName=myserver bash /cdrom/syslinux/install.sh
#
# To override the target disk:
#   TARGET_DISK=/dev/nvme0n1 bash /cdrom/syslinux/install.sh
#
# To force a specific boot mode (efi or bios) instead of auto-detecting:
#   BOOT_MODE=bios bash /cdrom/syslinux/install.sh
#   BOOT_MODE=efi  bash /cdrom/syslinux/install.sh
#
# =============================================================================

set -e

TARGET_DISK=${TARGET_DISK:-/dev/sda}
newName=${newName:-captainL}
BOOT_PART_SIZE=${BOOT_PART_SIZE:-2048MB}

# ---- Detect firmware mode (override with BOOT_MODE=efi|bios if auto-detect is wrong) ----

if [ -z "${BOOT_MODE}" ]; then
    if [ -d /sys/firmware/efi ]; then
        BOOT_MODE="efi"
    else
        BOOT_MODE="bios"
    fi
fi

if [ "${BOOT_MODE}" != "efi" ] && [ "${BOOT_MODE}" != "bios" ]; then
    echo "ERROR: BOOT_MODE must be 'efi' or 'bios' (got '${BOOT_MODE}')"
    exit 1
fi

# ---- Resolve partition variables by mode ----
#   EFI (GPT):  bios_grub=1  boot=2  data=3  mbr=gptmbr.bin
#   BIOS (MBR): boot=1       data=2          mbr=mbr.bin

if [ "${BOOT_MODE}" = "efi" ]; then
    BOOT_PART="${TARGET_DISK}2"
    DATA_PART="${TARGET_DISK}3"
    MBR_BIN="gptmbr.bin"
else
    BOOT_PART="${TARGET_DISK}1"
    DATA_PART="${TARGET_DISK}2"
    MBR_BIN="mbr.bin"
fi

echo "=== HomeVault disk installer ==="
echo "  Target disk : ${TARGET_DISK}"
echo "  Hostname    : ${newName}"
echo "  Boot mode   : ${BOOT_MODE}"
echo ""
echo "  WARNING: This will ERASE all data on ${TARGET_DISK}!"
echo "  Press Ctrl+C within 5 seconds to abort ..."
sleep 5

# ---- Partition the disk ----

if [ "${BOOT_MODE}" = "efi" ]; then
    # GPT layout — part 1 satisfies syslinux BIOS-GPT requirement,
    # part 2 is the ESP that EFI firmware finds for bootx64.efi.
    parted -a optimal -s "${TARGET_DISK}" \
        mklabel gpt \
        mkpart bios_grub 1MB 2MB \
        set 1 bios_grub on \
        mkpart ESP fat32 2MB "${BOOT_PART_SIZE}" \
        set 2 esp on
else
    # MBR layout — simpler and most compatible with legacy BIOS firmware.
    # No protective bios_grub partition needed; mbr.bin goes straight to MBR.
    parted -a optimal -s "${TARGET_DISK}" \
        mklabel msdos \
        mkpart primary fat32 1MB "${BOOT_PART_SIZE}" \
        set 1 boot on
fi

# ---- Format partitions ----
# FAT label is max 11 chars; truncation is silent so long hostnames should be avoided.

mkfs.vfat -F 32 -n "${newName}" "${BOOT_PART}"

# ---- Copy ISO contents to boot partition ----

mount "${BOOT_PART}" /mnt
cp -R /cdrom/* /mnt/

# ---- Customise hostname in boot menus ----

sed -i "s/{{ target_host_name }}/${newName}/g" /mnt/syslinux/syslinux.cfg
sed -i "s/{{ target_host_name }}/${newName}/g" /mnt/EFI/boot/grub.cfg

umount /mnt
# sync + udevadm settle are required before calling syslinux in BIOS mode.
# Without them, syslinux fails with "no such device or address" on /dev/sda1
# because the kernel hasn't fully released the block device after umount.
# sync flushes pending I/O; udevadm settle waits for udev to finish processing
# any partition-table re-read events so the device node is stable.
sync
udevadm settle

# ---- Install bootloader ----

dd if=/cdrom/syslinux/${MBR_BIN} of="${TARGET_DISK}" bs=440 count=1 conv=notrunc
/cdrom/syslinux/syslinux -f -i "${BOOT_PART}"

# ---- Summary ----

echo ""
echo "=== Installation complete ==="
if [ "${BOOT_MODE}" = "efi" ]; then
    echo "  EFI  boot : ${BOOT_PART} (ESP, label=${newName}) → EFI/boot/bootx64.efi"
    echo "  BIOS boot : ${TARGET_DISK} (gptmbr.bin) → syslinux on ${BOOT_PART}  [fallback]"
else
    echo "  BIOS boot : ${TARGET_DISK} (mbr.bin) → syslinux on ${BOOT_PART}"
fi
echo "  NOTE: Data partition not created — allocate remaining space manually:"
echo "    parted ${TARGET_DISK} mkpart primary ext4 ${BOOT_PART_SIZE} 100%"
echo "    mkfs.ext4 -L dat01 ${DATA_PART}"
echo "  Remove the ISO and reboot."
