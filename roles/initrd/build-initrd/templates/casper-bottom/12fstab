#!/bin/sh
# casper-bottom script: 12fstab
#
# Purpose:
#   Runs during the casper live-boot "bottom" phase to configure /etc/fstab
#   inside the target root filesystem (/root). It writes baseline entries
#   (tmpfs for /tmp) and then appends entries for any labelled block devices
#   declared via the Ansible variable `target_mount_device`.
#
# Casper hook conventions:
#   - PREREQ declares scripts that must run before this one (empty = no deps).
#   - The prereqs) case is called by casper to resolve ordering; do not remove.
#   - log_begin_msg / log_end_msg come from /scripts/casper-functions.

PREREQ=""
DESCRIPTION="Configuring fstab..."

# Path to the target fstab (casper mounts the live root at /root).
FSTAB="/root/etc/fstab"

prereqs()
{
    echo "$PREREQ"
}

case $1 in
# Return pre-requisite script names so casper can order execution correctly.
prereqs)
    prereqs
    exit 0
    ;;
esac

# Source casper helper functions (log_begin_msg, log_end_msg, etc.).
. /scripts/casper-functions

log_begin_msg "$DESCRIPTION"

# Write the baseline fstab entries.
#   - tmpfs on /tmp: volatile scratch space; nosuid and nodev for security.
#   - The root overlay (unionfs/overlayfs) is managed by casper itself and
#     does not need a static fstab entry, so it is intentionally omitted.
cat > "$FSTAB" <<EOF
# /etc/fstab — generated by casper-bottom/12fstab during live-boot
# <file system>  <mount point>  <type>   <options>         <dump>  <pass>
tmpfs            /tmp           tmpfs    nosuid,nodev      0       0
EOF

# Disable the checkroot init script in the target; the live root overlay is
# read-only at the block level and checkroot would fail or cause delays.
rm -f /root/etc/rcS.d/S*checkroot.sh

# Append fstab entries for each labelled device declared in Ansible.
# Each item in target_mount_device must provide:
#   label   — the filesystem label (matched exactly against /dev/disk/by-label/)
#   mountas — the mount point inside the target root
#   fstype  — (optional) filesystem type; defaults to ext4
{% if target_mount_device is defined and target_mount_device %}
  {% for item in target_mount_device %}
# Check for the label using its symlink path rather than parsing ls output,
# avoiding false positives from partial label matches (e.g. "data" vs "data2").
if [ -e "/dev/disk/by-label/{{ item.label }}" ]; then
    echo "LABEL={{ item.label }}  {{ item.mountas }}  {{ item.fstype | default('ext4') }}  defaults  0  2" >> "$FSTAB"
fi
  {% endfor %}
{% endif %}

log_end_msg 0