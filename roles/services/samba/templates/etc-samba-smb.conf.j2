{% macro generate_output(hash) %}
  {% for key, value in hash.items() %}
  {{"%-25s" | format(key) | replace("_"," ") }} = {{ value }}
  {% endfor %}
{% endmacro %}
#
# Samba configuration file for Debian GNU/Linux.
#
#=======================Samba Settings =======================
[global]
    server role               = standalone server
    server string             = %h file storage
    netbios name              = {{ target_host_name }}
    workgroup                 = WORKGROUP
    passdb backend            = tdbsam

    # Protocol
    server min protocol       = SMB2
    server max protocol       = SMB3

    # Guest access
    security                  = user
    map to guest              = Bad User
    guest account             = nobody
    # obey pam restrictions must be no — Ubuntu's nobody user has a locked
    # account; with yes, PAM rejects the guest session and the client sees
    # "share does not exist" instead of being served the share.
    obey pam restrictions     = no

    # File/directory defaults
    create mask               = 0660
    directory mask            = 0770
    hide files                = /.*/lost+found/
    hide unreadable           = yes
    unix extensions           = no
    wide links                = yes
    follow symlinks           = yes
    use sendfile              = yes

    # Misc
    unix charset              = UTF8
    deadtime                  = 10
    max log size              = 1000
    locking                   = yes
    unix password sync        = no
    browseable                = yes
    wins support              = no
    invalid users             = bin daemon adm sync shutdown halt mail news uucp proxy www-data backup sshd
    log file                  = /var/log/samba/log.%m
    log level                 = 1
{% if samba_conf_global is defined and samba_conf_global %}
{{ generate_output(hash=samba_conf_global) }}
{% endif %}

#======================= Share Settings =======================
{% if samba_conf_share is defined and samba_conf_share %}
{% for item in samba_conf_share.keys() %}
[{{ item }}]
{{ generate_output(hash=samba_conf_share[item]) }}
{% endfor %}
{% endif %}