. /lib/lsb/init-functions

# check {{ install_role_name }} setup stamp
if [ ! -f "/etc/setup_{{ install_role_name }}.stamp" ]; then
    log_begin_msg "initializing environment before starting {{ install_role_name }} services"

    # Create containerd and docker data directories on the persistent data partition.
    # These paths must exist on the ext4 data partition BEFORE containerd/docker start.
    # The live rootfs is an overlayfs (casper); containerd's overlayfs snapshotter
    # cannot be nested inside another overlayfs, so data must live on a real filesystem.
    [ ! -d "{{ target_appdata_root }}/containerd" ] && /bin/mkdir -p "{{ target_appdata_root }}/containerd"
    [ ! -d "{{ target_appdata_root }}/docker" ]     && /bin/mkdir -p "{{ target_appdata_root }}/docker"

    touch "/etc/setup_{{ install_role_name }}.stamp"
    log_end_msg 0
fi

exit 0
