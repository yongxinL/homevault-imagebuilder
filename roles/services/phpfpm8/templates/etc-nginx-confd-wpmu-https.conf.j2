#
# nginx default configuration for unknown virtual host
# designed to be included in any http {} block.
#

map $http_host $blogid {
    default       -999;

    #Ref: http://wordpress.org/extend/plugins/nginx-helper/
    #include {{ target_data_root }}/public_html/wp-content/plugins/nginx-helper/map.conf;
}

# (/drive nextcloud) Set the `immutable` cache control options only for assets with a cache busting `v` argument
map $arg_v $asset_immutable {
    "" "";
    default ", immutable";
}

server {

    listen                  443 ssl default_server;
    listen                  [::]:443 ssl default_server;

    # virtual host domains
    server_name             _;

    # redirect to HTTPd for non-primary domains
    #if ( $http_host !~* "{{ target_host_domain|lower }}" ) {
    #    rewrite  ^(.*)$ http://$http_host$request_uri;
    #}

    # public html root
    root                    {{ target_data_root }}/public_html;

    # public certificate and its private key
    #ssl_certificate         /etc/ssl/{{ target_host_domain|lower }}.pem;
    #ssl_certificate_key     /etc/ssl/{{ target_host_domain|lower }}.key;

    # self-sign certificate and its private key
    ssl_certificate         /etc/ssl/private/servfarm.pem;
    ssl_certificate_key     /etc/ssl/private/servfarm.key;
    ssl_dhparam             /etc/ssl/private/dh_2048.pem;

    # Prevent nginx HTTP Server Detection
    server_tokens off;

    # global restriction rules, comment out for SSL certificate authorization
    include                 /etc/nginx/conf.d/restrictions.ini;

    # Pass the PHP scripts to FastCGI server (locally with unix: param to avoid network overhead)
    location ~ \.php$ {
        # Prevent Zero-day exploit
        try_files           $uri = 404;
        fastcgi_split_path_info ^(.+\.php)(/.+)$;

        # NOTE: you should have "cgi.fix_pathinfo = 0;" in php.ini
        include             /etc/nginx/fastcgi_params;
        fastcgi_intercept_errors    on;
        fastcgi_pass        unix:{{ php_fastcgi }};
        fastcgi_param       SCRIPT_FILENAME     $document_root$fastcgi_script_name;
        fastcgi_buffers     16 16k;
        fastcgi_buffer_size 32k;
    }

    location / {
        # include the "?$args" part so non-default permalinks doesn't break when using query string
        try_files           $uri $uri/ /index.php?$args;
        add_header          Access-Control-Allow-Origin *;
        add_header          X-Frame-Options "ALLOW-FROM {{ target_host_domain }}";
        add_header          Content-Security-Policy "frame-ancestors {{ target_host_domain }}";
    }

    # wordpress multisite subdomain
    location ~ ^/files/(.*)$ {
        try_files           /wp-content/blogs.dir/$blogid/$uri /wp-includes/ms-files.php?file=$1 ;
        access_log          off;
        log_not_found       off;
        expires             max;
    }

    location ^~ /blogs.dir {
        internal;
        alias               {{ target_data_root }}/public_html/wp-content/blogs.dir;
        access_log          off;
        log_not_found       off;
        expires             max;
    }

    # add some rules for static content expiry-headers here
    #include                 /etc/nginx/conf.d/drive-subdir.conf;
    #include                 /etc/nginx/conf.d/scholar-subdir.conf;
    #include                 /etc/nginx/conf.d/wiki-subdir.conf;
}