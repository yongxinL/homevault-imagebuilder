# =============================================================================
# /lib/systemd/system/overlayfs.service
# ======================================
# Managed by Ansible (HomeVault imagebuilder — basefs/build-basefs role)
#
# Systemd service unit that runs /etc/init.d/mount-overlayfs at boot time.
# Must execute before sysinit.target so that /etc, /var/log, /home, and /opt
# are writable before any other services start.
#
# The 'Wants=network-pre.target' dependency ensures network configuration
# (Netplan / systemd-networkd) starts after the overlays are in place so
# changes to /etc/netplan persisted on the data partition take effect.
# =============================================================================

[Unit]
Description=Mount writable overlay filesystems (HomeVault overlayfs service)
DefaultDependencies=no
After=local-fs.target
Before=sysinit.target network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
ExecStart=/etc/init.d/mount-overlayfs start
ExecStop=/etc/init.d/mount-overlayfs stop
TimeoutSec=0
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
